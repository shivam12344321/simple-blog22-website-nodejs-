<div class="post-page">
  <article class="post-full">
    <div class="post-header">
      <h1><%= post.title %></h1>
      <div class="post-meta">
        <span class="author">By <strong><%= post.username %></strong></span>
        <span class="date"><%= new Date(post.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
      </div>
    </div>

    <div class="post-content">
      <%= post.content %>
    </div>

    <% if (typeof user !== 'undefined' && user && user.id === post.author_id) { %>
      <div class="post-actions">
        <a href="/posts/edit/<%= post.id %>" class="btn btn-secondary">✏️ Edit</a>
        <form method="POST" action="/posts/delete/<%= post.id %>" style="display:inline;">
          <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure?')">🗑️ Delete</button>
        </form>
      </div>
    <% } %>
  </article>

  <div class="back-link">
    <a href="/">← Back to Posts</a>
  </div>
</div>