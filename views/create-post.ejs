<div class="form-page">
  <h1>Create New Post</h1>
  
  <% if (errors && errors.length > 0) { %>
    <div class="errors">
      <% errors.forEach(error => { %>
        <p class="error-msg">❌ <%= error.msg %></p>
      <% }); %>
    </div>
  <% } %>

  <form method="POST" action="/posts/create" class="form">
    <div class="form-group">
      <label for="title">Post Title</label>
      <input type="text" id="title" name="title" required placeholder="Enter an engaging title">
    </div>

    <div class="form-group">
      <label for="content">Post Content</label>
      <textarea id="content" name="content" rows="12" required placeholder="Write your amazing post here..."></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">📝 Publish Post</button>
      <a href="/" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>